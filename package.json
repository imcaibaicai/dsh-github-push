{
  "name": "dsh-github-push",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件与独立工具：一键静默将本地目录推送到 GitHub。零外部依赖（免 gh CLI），大模型零信任凭据气闸（Token 永不出机），网络自动代理探测与 TLS 加固，全流程自动化托收与 SHA 回读校验。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-github-push": "./bin/push.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/push.mjs",
    "lib/index.js",
    "lib/engine.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "git",
    "push",
    "silent-push",
    "agent-tools"
  ]
}
